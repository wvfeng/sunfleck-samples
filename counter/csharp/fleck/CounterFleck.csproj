<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <FleckPage>counter</FleckPage>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <SunfleckModel Include="CounterModel" />
    <!-- The running application watches Fleck itself; saving a page must not restart it. -->
    <None Update="counter.fleck" Watch="false" />
  </ItemGroup>
  <Import Project="../../../Fleck.targets" />
  <Import Project="$(SunfleckDevelopmentTargets)" Condition="'$(SunfleckDevelopmentTargets)' != ''" />
</Project>
