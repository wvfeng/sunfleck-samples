<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="urn:sunfleck:v1" Title="Sunfleck Counter" Width="360" Height="180">
  <StackPanel Spacing="8" Padding="16">
    <TextBlock Id="count" Text="{Binding count, StringFormat='Count: {0}'}"/>
    <Button Id="increment" Content="{Binding caption}" Command="{Binding increment}" CommandMode="Async"/>
  </StackPanel>
</Window>
